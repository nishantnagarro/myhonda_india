# ==============================================================================
# Enterprise .gitignore for React Native / Expo (MyHonda India)
# ==============================================================================

# --- Node & Dependencies ---
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*
.pnpm-debug.log*

# --- Environment & Secrets (NEVER COMMIT SECRETS) ---
.env
.env.*
!.env.example

# --- Certificates & Private Keys ---
*.pem
*.key
*.jks
*.p8
*.p12
*.keystore
*.mobileprovision

# --- Expo & Metro ---
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# --- Generated Native Folders (Prebuild) ---
/ios
/android

# --- Android Build & Local Paths ---
.gradle/
build/
android/app/build/
android/.gradle/
local.properties
*.apk
*.aab
*.dex

# --- iOS & CocoaPods ---
Pods/
ios/Pods/
DerivedData/
*.ipa
*.xcuserstate
*.xcuserdatad

# --- Tests & Code Quality Caches ---
coverage/
.nyc_output/
.eslintcache
.prettiercache
*.tsbuildinfo

# --- Fastlane & Release Tooling ---
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# --- Operating System Artifacts ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# --- IDE & Editors ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
